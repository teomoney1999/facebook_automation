# Facebook Bot Credentials
EMAIL=your_email_or_phone@example.com
PASSWORD=your_facebook_password

# Anti-Ban Delays & Batch Limits
MIN_DELAY_BETWEEN_POSTS=45.0
MAX_DELAY_BETWEEN_POSTS=90.0
MAX_POSTS_PER_RUN=10
COOLDOWN_HOURS=24

# Group Joining Timing & Limits
JOIN_DELAY_MIN=15.0
JOIN_DELAY_MAX=35.0
JOIN_LIMIT=10

# Optional Telegram Remote Control (Leave empty if not using Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# Headless / Silent Browser Execution (true = ẩn Chrome, false = mở cửa sổ)
HEADLESS=false
HEADLESS_MODE=new

# Software Auto-Update & Selectors Hot-Patch URLs
UPDATE_CHECK_URL=https://raw.githubusercontent.com/teomoney1999/facebook_automation/main/version.json
SELECTORS_REMOTE_URL=https://raw.githubusercontent.com/teomoney1999/facebook_automation/main/repo/json/selectors.json

